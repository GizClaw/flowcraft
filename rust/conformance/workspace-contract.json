    {
      "name": "capped-bounded",
      "why": "a medium that can bound a read refuses an oversized file at the read layer, with the sentence that says so",
      "files": [
        {
          "path": "a.txt",
          "data": "0123456789"
        }
      ],
      "limited": true,
      "ops": [
        {
          "op": "capped",
          "path": "a.txt",
          "max": 10,
          "ok": true,
          "data": "0123456789"
        },
        {
          "op": "capped",
          "path": "a.txt",
          "max": 9,
          "ok": false,
          "error": "workspace: a.txt exceeds 9 bytes"
        },
        {
          "op": "capped",
          "path": "a.txt",
          "max": 20,
          "ok": true,
          "data": "0123456789"
        },
        {
          "op": "capped",
          "path": "nope.txt",
          "max": 5,
          "ok": false,
          "error": "workspace: not found: nope.txt"
        },
        {
          "op": "capped",
          "path": "a.txt",
          "ok": false,
          "error": "workspace: read cap must be positive, got 0"
        }
      ],
      "final": [
        {
          "path": "a.txt",
          "data": "0123456789"
        }
      ]
    },
