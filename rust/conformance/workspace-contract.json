          "ok": false,
          "error": "workspace: not found: nope.txt"
        },
        {
          "op": "stat",
          "path": "nope.txt",
          "ok": false,
          "error": "workspace: not found: nope.txt"
        },
        {
          "op": "rename",
          "path": "nope.txt",
          "arg": "x.txt",
          "ok": false,
          "error": "workspace: not found: nope.txt"
        },
        {
          "op": "list",
          "path": "nope",
          "ok": true
        },
        {
          "op": "delete",
          "path": "nope.txt",
          "ok": true
        },
        {
          "op": "remove_all",
          "path": "nope",
          "ok": true
        }
      ],
      "final": [
        {
          "path": "a.txt",
          "data": "a"
        }
      ]
    },
    {
      "name": "raw-traversal",
