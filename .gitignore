# Whitelist mode: ignore everything, then allow explicitly
*

# ── Git config ──
!.gitignore

# ── Root documentation ──
!README.md
!LICENSE
!CHANGELOG.md
!CHANGELOG.legacy.md
!SECURITY.md
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md
!docs/
!docs/_config.yml
!docs/index.md
!docs/guides/
!docs/guides/**
!docs/migrations/
!docs/migrations/**

# ── Go CI ──
!.golangci.yml

# ── Repository tooling ──
# New top-level files are ignored until they are named here, which is how a
# whole PR's worth of configuration can be written, reviewed and merged without
# ever being committed. These two were exactly that.
!.prettierrc.json
!.prettierignore

# ── Go source ──
!go.mod
!go.sum
!go.work
!agent/
!agent/**
!core/
!core/**
!inference/
!inference/**
!examples/
!examples/**
!sandbox/
!sandbox/**
!scripts/
!scripts/**
# A `go build` in the release gate drops a binary beside its package.
/scripts/releasegate/releasegate
!skills/
!skills/**
!tool/
!tool/**
!.release/
!.release/**

# ── CI/CD ──
!Makefile
!.github/
!.github/**

# ── Global excludes (override all allowed dirs) ──
**/.DS_Store
**/Thumbs.db
**/*.exe
**/*.exe~
**/*.dll
**/*.so
**/*.dylib
**/*.test
**/*.out
**/*.prof
**/*.swp
**/*.swo
**/*~
**/.env
**/.env.local
**/.env.production
**/vendor/
**/.idea/
**/.vscode/
**/__debug_bin*
skills/flowcraft-config/scripts/validator/validator
